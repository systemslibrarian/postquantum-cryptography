* text=auto eol=lf

# Force binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.snk binary
*.pfx binary
*.nupkg binary
*.snupkg binary

# Force LF on text types so deterministic builds match across OS.
*.cs           text eol=lf
*.csproj       text eol=lf
*.slnx         text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
