<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local feed for the smoke test. The runner pre-populates ../../artifacts/packages
       with the freshly-packed .nupkg, and restore picks it up via this feed. -->
  <packageSources>
    <clear />
    <add key="local-packages" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="PostQuantum.Cryptography" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
