<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Test-only differential reference for X25519. NOT a dependency of the
         library itself; this PackageReference lives on the tests project only
         so it never reaches the published .nupkg or its consumers. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PostQuantum.Cryptography/PostQuantum.Cryptography.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authoritative third-party vector sets consumed at test run time:
         Project Wycheproof (C2SP/wycheproof, testvectors_v1) and curated
         NIST ACVP-Server gen-val subsets. See each file's provenance header
         or the matching *Tests.cs for the upstream commit/URL. -->
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
