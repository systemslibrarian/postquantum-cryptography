<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PostQuantum.Cryptography.Fuzz</RootNamespace>
    <AssemblyName>PostQuantum.Cryptography.Fuzz</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Fuzzing harness has its own constraints; don't fail it on stylistic
         analyzer findings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PostQuantum.Cryptography/PostQuantum.Cryptography.csproj" />
  </ItemGroup>

</Project>
