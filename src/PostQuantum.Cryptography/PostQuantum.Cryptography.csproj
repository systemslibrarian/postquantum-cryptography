<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>PostQuantum.Cryptography</RootNamespace>
    <AssemblyName>PostQuantum.Cryptography</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- PublicApiAnalyzer also tracks Internal APIs by default; we use
         InternalsVisibleTo only for tests and do not need that ceremony.
         RS0051/RS0056 are the internal-API equivalents of RS0016/RS0036. -->
    <NoWarn>$(NoWarn);RS0051;RS0056</NoWarn>
  </PropertyGroup>

  <!-- Assembly identity. Keep AssemblyVersion stable across patch releases so
       strong-name/binding-redirect consumers don't churn; bump FileVersion and
       InformationalVersion with each release. -->
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.1</InformationalVersion>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PostQuantum.Cryptography</PackageId>
    <Version>1.0.0-rc.1</Version>
    <Title>PostQuantum.Cryptography — clean, secure-by-default post-quantum primitives for .NET 10</Title>
    <Description>The foundation post-quantum cryptography library for .NET 10. Clean, high-level, secure-by-default wrappers over the BCL's native FIPS 203 (ML-KEM) and FIPS 204 (ML-DSA) implementations across all parameter sets, plus a spec-compliant X-Wing hybrid KEM (ML-KEM-768 + X25519, draft-connolly-cfrg-xwing-kem) for the recommended PQ/T migration path. Two complementary APIs: a typed disposable-key surface for long-lived keys, and a byte-oriented one-shot surface for fire-and-forget use. Span-based zero-allocation overloads, PEM/PKCS#8/SPKI interchange with up-front label validation, AOT/trim ready, deterministic builds, SourceLink, and the public API is locked by Microsoft.CodeAnalysis.PublicApiAnalyzers. Six runnable samples, recipes cookbook, and benchmarks ship with the repo.</Description>
    <PackageTags>post-quantum;pqc;cryptography;ml-kem;mlkem;kyber;ml-dsa;mldsa;dilithium;x-wing;xwing;hybrid;kem;signature;fips-203;fips-204;ietf;security;encryption;net10;dotnet;aot;trimmable;span;zero-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/systemslibrarian/postquantum-cryptography</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/systemslibrarian/postquantum-cryptography/blob/main/CHANGELOG.md#$(Version.Replace('.', '').Replace('-', ''))</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- PackageIcon: drop a 128x128 PNG at `assets/icon.png` and uncomment.
         The .nupkg ItemGroup below already conditionally packs it. -->
    <!-- <PackageIcon>icon.png</PackageIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Condition="Exists('../../THIRD-PARTY-NOTICES.md')" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Condition="Exists('../../assets/icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PostQuantum.Cryptography.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.26226.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
